# Solo per il vecchio proxy Node locale (`npm run server`).
# Con la Supabase Edge Function la chiave va nei Secrets:
#   supabase secrets set GEMINI_API_KEY=LA_TUA_CHIAVE
# NON caricare mai la chiave reale su GitHub.

GEMINI_API_KEY=your_api_key_here

# Modello Gemini usato per OCR e spiegazioni.
# Modello primario consigliato: gemini-3.6-flash (gemini-2.0-flash è disattivato).
# La Edge Function ha già un fallback automatico su 3.5-flash-lite e 3.8-flash.
GEMINI_MODEL=gemini-3.6-flash

# Porta del server locale (opzionale).
PORT=3000
